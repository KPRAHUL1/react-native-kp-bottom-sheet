{
  "name": "react-native-kp-bottom-sheet",
  "version": "0.1.0",
  "description": "A bottom sheet for React Native that actually works on Android — no <Modal>, gesture-driven, portalled above tab bars.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "react-native",
    "bottom-sheet",
    "sheet",
    "modal",
    "actionsheet",
    "reanimated",
    "expo",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KPRAHUL1/react-native-kp-bottom-sheet.git"
  },
  "bugs": {
    "url": "https://github.com/KPRAHUL1/react-native-kp-bottom-sheet/issues"
  },
  "homepage": "https://github.com/KPRAHUL1/react-native-kp-bottom-sheet#readme",
  "author": "KP Rahul <kprahul1143@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.14.0",
    "react-native-reanimated": ">=3.6.0",
    "react-native-safe-area-context": ">=4.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "0.5.1",
    "typescript": "~5.9.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
